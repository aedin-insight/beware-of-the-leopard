#!/usr/bin/env python3
"""ask: send a prompt to a language model via OpenRouter and stream the reply."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

API_URL = "https://openrouter.ai/api/v1/chat/completions"
DEFAULT_MODEL = "nvidia/nemotron-3.5-lightning:free"
TIMEOUT_SECONDS = 60


def fail(message, code=1):
    print(f"ask: {message}", file=sys.stderr)
    sys.exit(code)


def read_prompt(args):
    if args.prompt:
        return " ".join(args.prompt).strip()
    if not sys.stdin.isatty():
        return sys.stdin.read().strip()
    return ""


def api_error(body):
    try:
        return json.loads(body)["error"]["message"]
    except (ValueError, KeyError, TypeError):
        return body.strip()[:200] or "no details"


def stream(prompt, model, key):
    payload = json.dumps({
        "model": model,
        "stream": True,
        "messages": [{"role": "user", "content": prompt}],
    }).encode()
    request = urllib.request.Request(API_URL, data=payload, headers={
        "Authorization": f"Bearer {key}",
        "Content-Type": "application/json",
    })
    wrote_text = False
    with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
        for raw in response:
            line = raw.decode("utf-8").strip()
            if not line.startswith("data:"):
                continue  # blank lines and ": OPENROUTER PROCESSING" keep-alives
            data = line[5:].strip()
            if data == "[DONE]":
                break
            chunk = json.loads(data)
            if "error" in chunk:  # errors can arrive mid-stream with HTTP 200
                if wrote_text:
                    print()
                fail(f"model error: {chunk['error'].get('message', 'unknown')}")
            for choice in chunk.get("choices", []):
                text = (choice.get("delta") or {}).get("content")
                if text:
                    sys.stdout.write(text)
                    sys.stdout.flush()
                    wrote_text = True
    if not wrote_text:
        fail("the model returned an empty response")
    print()


def main():
    parser = argparse.ArgumentParser(
        prog="ask",
        description="Send a prompt to a language model via OpenRouter. "
                    "Reads OPENROUTER_API_KEY from the environment.",
        epilog='examples:  ask "why is the sky blue?"   |   cat notes.txt | ask',
    )
    parser.add_argument("prompt", nargs="*", help="the prompt (or pipe it in on stdin)")
    parser.add_argument("-m", "--model", default=DEFAULT_MODEL,
                        help=f"OpenRouter model id (default: {DEFAULT_MODEL})")
    args = parser.parse_args()

    prompt = read_prompt(args)
    if not prompt:
        parser.print_usage(sys.stderr)
        fail("no prompt given. Pass it as an argument or pipe it on stdin.", 2)

    key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if not key:
        fail("OPENROUTER_API_KEY is not set. Get a key at https://openrouter.ai/keys")

    try:
        stream(prompt, args.model, key)
    except urllib.error.HTTPError as e:
        hint = " (free models are often rate-limited; retry or try another with --model)" if e.code == 429 else ""
        fail(f"OpenRouter returned HTTP {e.code}: {api_error(e.read().decode('utf-8', 'replace'))}{hint}")
    except urllib.error.URLError as e:
        fail(f"could not reach OpenRouter: {e.reason}")
    except TimeoutError:
        fail(f"no response from OpenRouter within {TIMEOUT_SECONDS}s")
    except json.JSONDecodeError:
        fail("received a malformed response from OpenRouter")
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
    except BrokenPipeError:
        # e.g. `ask ... | head`: stop quietly (per Python's SIGPIPE docs)
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)


if __name__ == "__main__":
    main()
